# Copy to .env (or set in your host's dashboard) — NEVER commit real keys

# From https://dashboard.stripe.com/test/apikeys (use test keys first)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# From Stripe dashboard -> Developers -> Webhooks (endpoint: /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Any long random string — protects GET /api/orders
ADMIN_TOKEN=change-me-to-a-long-random-string

# Public URL of the deployed site (used for checkout redirects)
BASE_URL=https://your-app.onrender.com

# Google Sign-In (optional) — from https://console.cloud.google.com
# APIs & Services -> Credentials -> Create OAuth client ID (Web application)
# Add your site URL to "Authorized JavaScript origins". The client ID is public; there is no secret needed for this flow.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
